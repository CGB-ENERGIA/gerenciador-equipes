{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist/spa",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    { "source": "/api/:caminho*", "destination": "/api/index" }
  ],
  "redirects": [
    { "source": "/resumo", "destination": "/#/resumo", "permanent": false }
  ]
}
